# Contoh konfigurasi produksi untuk VPS. Salin menjadi .env di root repo, lalu isi nilainya.
# Jangan commit berkas .env yang sudah berisi rahasia (sudah ada di .gitignore).

APP_ENV=production
APP_DEBUG=false
APP_URL=https://aduan.aispektra.com

# Kunci aplikasi: hasilkan baru di VPS dengan
#   docker compose run --rm --entrypoint php app artisan key:generate --show
APP_KEY=

APP_PORT=8080
# Hanya dilayani reverse proxy (Caddy/Nginx) di mesin yang sama.
APP_BIND=127.0.0.1

DB_CONNECTION=pgsql
DB_DATABASE=sik
DB_USERNAME=postgres
# Kata sandi kuat, simpan di password manager. Dipakai juga saat restore cadangan.
DB_PASSWORD=

# Email: gunakan smtp pada produksi. MAIL_MAILER=log hanya menulis ke log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@kabupaten.go.id
MAIL_FROM_NAME="Aduan Infrastruktur"

# Jalur Python di dalam image; jangan diubah untuk container Linux.
AI_PYTHON_BINARY=/usr/bin/python3
AI_CV_PROVIDER=opencv

# Hanya diperlukan bila memakai Cloudflare Tunnel, bukan reverse proxy biasa.
# TUNNEL_TOKEN=
