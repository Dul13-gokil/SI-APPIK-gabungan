APP_NAME="Sistem Pengaduan Infrastruktur Kabupaten"
APP_ENV=local
APP_KEY=base64:c3VwZXJzZWNyZXRrZXlmb3JsYXJhdmVsYXBwbGljYXRpb24=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Connection (PostgreSQL with PostGIS)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aduan_kabupaten
DB_USERNAME=postgres
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kabupaten.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# Business & SAP Configuration Parameters (SAP Section 32)
DUPLICATE_RADIUS_M=100
UPLOAD_MAX_MB=10
AI_CV_PROVIDER=mock
AI_CV_CONFIDENCE_THRESHOLD=0.75
FCM_SERVER_KEY=
MAPS_API_KEY=
